	if state then
		Main.Size = UDim2.fromOffset(700, 450)
		TweenService:Create(Main, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
			Size = UDim2.fromOffset(760, 490)
		}):Play()
	else
		local tween = TweenService:Create(Main, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
			Size = UDim2.fromOffset(680, 430)
		})
		tween:Play()
		tween.Completed:Connect(function()
			if not menuOpen then Main.Visible = false end
		end)
	end
end

