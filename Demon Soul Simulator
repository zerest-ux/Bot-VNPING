local function CreatePage(name)
	local Content = Instance.new("ScrollingFrame")
	Content.Name = name .. "Page"
	Content.Size = UDim2.new(1, 0, 1, 0)
	Content.BackgroundTransparency = 1
	Content.BorderSizePixel = 0
	Content.ScrollBarThickness = 3
	Content.ScrollBarImageColor3 = CYAN
	Content.CanvasSize = UDim2.new(0, 0, 0, 0)
	Content.Visible = false
	Content.Parent = PagesContainer

	local ContentLayout = Instance.new("UIListLayout", Content)
	ContentLayout.Padding = UDim.new(0, 8)

	local ContentPadding = Instance.new("UIPadding", Content)
	ContentPadding.PaddingRight = UDim.new(0, 10)

	ContentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		Content.CanvasSize = UDim2.new(0, 0, 0, ContentLayout.AbsoluteContentSize.Y + 15)
	end)

	Pages[name] = Content
	return Content
end

local function AddTab(name, icon)
	local B = Instance.new("TextButton")
	B.Size = UDim2.fromOffset(165, 42)
	B.BackgroundColor3 = DARK
	B.Text = icon .. "  " .. name
	B.TextColor3 = CYAN
	B.TextSize = 13
	B.Font = Enum.Font.GothamSemibold
	B.Parent = Side

	Instance.new("UICorner", B).CornerRadius = UDim.new(0, 8)
	local S = Instance.new("UIStroke", B)
	S.Color = CYAN
	S.Thickness = 1
	S.Transparency = 0.5

	CreatePage(name)

	B.MouseButton1Click:Connect(function()
		for pageName, pageObj in pairs(Pages) do
			pageObj.Visible = (pageName == name)
		end
		for _, btn in pairs(TabButtons) do
			TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = DARK}):Play()
		end
		TweenService:Create(B, TweenInfo.new(0.2), {BackgroundColor3 = DARK3}):Play()
	end)

	table.insert(TabButtons, B)
	return B
end

